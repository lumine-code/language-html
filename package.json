{
  "name": "language-html",
  "author": "lumine-code",
  "version": "1.0.0",
  "files": [
    "grammars",
    "lib",
    "settings",
    "snippets",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "description": "HTML language support.",
  "keywords": [
    "erb",
    "ejs",
    "xhtml",
    "tree-sitter"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "repository": "https://github.com/lumine-code/language-html",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "bugs": {
    "url": "https://github.com/lumine-code/language-html/issues"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "specPackages": [
    "language-hyperlink",
    "language-ruby",
    "symbol-tree-sitter",
    "language-css",
    "language-javascript"
  ],
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.5"
    }
  }
}
