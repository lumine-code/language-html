{
  "name": "HTML",
  "scopeName": "text.html.basic",
  "type": "tree-sitter",
  "parser": "tree-sitter-html",
  "injectionNames": ["html"],
  "firstLineRegex": "<(?:!DOCTYPE\\s*)?html|-\\*-(?:\\s*(?=[^:;\\s]+\\s*-\\*-)|(?:.*?[;\\s]|(?<=-\\*-))mode\\s*:\\s*)html(?=[\\s;]|(?<![-*])-\\*-).*?-\\*-|(?:(?:\\s|^)vi(?:m[<=>]?\\d+|m)?|\\sex)(?=:(?=\\s*set?\\s[^\\n:]+:)|:(?!\\s*set?\\s))(?:(?:\\s|\\s*:\\s*)\\w*(?:\\s*=(?:[^\\n\\\\\\s]|\\\\.)*)?)*[\\s:](?:filetype|ft|syntax)\\s*=x?html(?=\\s|:|$)",
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-html#v0.23.2",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "html.wasm",
    "highlightsQuery": "html-highlights.scm",
    "foldsQuery": "html-folds.scm",
    "indentsQuery": "html-indents.scm"
  },
  "fileTypes": ["htm", "html", "shtml", "xhtml"],
  "comments": {
    "start": "<!-- ",
    "end": " -->",
    "block": ["<!--", "-->"]
  }
}
