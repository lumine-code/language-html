{
  "name": "HTML",
  "scopeName": "text.html.basic",
  "type": "tree-sitter",
  "parser": "tree-sitter-html",
  "injectionNames": ["html", "xhtml"],
  "firstLineRegex": [
    // Modeline tokens are separated from their delimiters so failed prefixes
    // cannot be partitioned into overlapping matches.
    "<(?:!DOCTYPE\\s*)?html",
    "-\\*-[ \\t]*html(?=[ \\t;]|-\\*-)(?:(?!-\\*-).)*-\\*-",
    "-\\*-(?:(?!-\\*-|\\bmode[ \\t]*:[ \\t]*html(?=[ \\t;]|-\\*-)).)*\\bmode[ \\t]*:[ \\t]*html(?=[ \\t;]|-\\*-)(?:(?!-\\*-).)*-\\*-",
    "^(?:(?!(?:^|\\s)(?:vi(?:m(?:[<=>]?\\d+)?)?|ex)(?=:)).)*(?:^|\\s)(?:vi(?:m(?:[<=>]?\\d+)?)?|ex)(?=:)(?:[ \\t:]+\\w+(?:[ \\t]*=(?:[^\\r\\n\\\\\\s:]|\\\\.)*)?)*[ \\t:]+(?:filetype|ft|syntax)[ \\t]*=[ \\t]*x?html(?=[ \\t:]|$)"
  ],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-html#v0.23.2",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "html.wasm",
    "highlightsQuery": "html-highlights.scm",
    "injectionsQuery": "html-injections.scm",
    "foldsQuery": "html-folds.scm",
    "indentsQuery": "html-indents.scm"
  },
  "fileTypes": ["htm", "html", "shtml", "xhtml"],
  "comments": {
    "start": "<!-- ",
    "end": " -->",
    "block": ["<!--", "-->"]
  }
}
